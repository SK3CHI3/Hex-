{
  "name": "hex-ai",
  "version": "2.0.0",
  "description": "AI-powered penetration testing assistant — runs in your terminal",
  "type": "module",
  "bin": {
    "hex": "./cli/index.js"
  },
  "scripts": {
    "start": "node cli/index.js",
    "docker:build": "cd server/docker && docker compose build",
    "docker:up": "cd server/docker && docker compose up -d",
    "docker:down": "cd server/docker && docker compose down",
    "docker:logs": "cd server/docker && docker compose logs -f kali-tools"
  },
  "keywords": [
    "pentesting",
    "security",
    "red-team",
    "ai",
    "cli",
    "kali-linux"
  ],
  "author": "Hex AI Team",
  "license": "MIT",
  "dependencies": {
    "chalk": "^5.3.0",
    "dotenv": "^16.4.5"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
